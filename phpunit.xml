<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <!--
            The slowest files first. Paratest hands the files to its workers in suite order, and the order of the
            directory scan puts TwentyOneStream*Test (each ~40 s of wall clock: the daemon runs its stop-after seconds
            for real) near the end, so four workers ran on alone for 30 s after the other twenty had finished
            (measured 2026-10-23: 24 workers, the last four ended at 118 s, the rest at 80 s). A file listed here
            is excluded from its directory's suite below (else PHPUnit warns and the run exits 1). Re-order when scripts/test-profile.php shows a
            worker far behind the others.
        -->
        <testsuite name="Heavy">
            <file>tests/Feature/TwentyOneStreamPart2Test.php</file>
            <file>tests/Feature/TwentyOneStreamTest.php</file>
            <file>tests/Feature/TwentyOneStreamPart4Test.php</file>
            <file>tests/Feature/TwentyOneStreamPart3Test.php</file>
            <file>tests/Feature/Seo/PageCardsTest.php</file>
            <file>tests/Feature/Caster/PodcastReplayTest.php</file>
            <file>tests/Feature/StreamBot/ProfileVarietyTest.php</file>
            <file>tests/Feature/SeasonChain/TrustJobTest.php</file>
            <file>tests/Feature/Caster/PatternScriptsTest.php</file>
            <file>tests/Feature/Caster/MusicFirstTest.php</file>
            <file>tests/Feature/Caster/ChatWishesTest.php</file>
            <file>tests/Feature/Payouts/PotReleaseTest.php</file>
            <file>tests/Feature/Payouts/TournamentPayoutTest.php</file>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <!-- In the Heavy suite above: listed twice, PHPUnit warns and the run exits 1 with every test green. -->
            <exclude>tests/Feature/TwentyOneStreamPart2Test.php</exclude>
            <exclude>tests/Feature/TwentyOneStreamTest.php</exclude>
            <exclude>tests/Feature/TwentyOneStreamPart4Test.php</exclude>
            <exclude>tests/Feature/TwentyOneStreamPart3Test.php</exclude>
            <exclude>tests/Feature/Seo/PageCardsTest.php</exclude>
            <exclude>tests/Feature/Caster/PodcastReplayTest.php</exclude>
            <exclude>tests/Feature/StreamBot/ProfileVarietyTest.php</exclude>
            <exclude>tests/Feature/SeasonChain/TrustJobTest.php</exclude>
            <exclude>tests/Feature/Caster/PatternScriptsTest.php</exclude>
            <exclude>tests/Feature/Caster/MusicFirstTest.php</exclude>
            <exclude>tests/Feature/Caster/ChatWishesTest.php</exclude>
            <exclude>tests/Feature/Payouts/PotReleaseTest.php</exclude>
            <exclude>tests/Feature/Payouts/TournamentPayoutTest.php</exclude>
        </testsuite>
        <testsuite name="Nostr">
            <directory>tests/Nostr</directory>
        </testsuite>
        <testsuite name="Relay">
            <directory>tests/Relay</directory>
        </testsuite>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>browser</group>
            <group>relay</group>
            <group>integration</group>
            <!-- Hyperbitcoinization: builds tools/hbsim (cargo) and replays 6,000 games; on demand only. -->
            <group>hbsim-parity</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The parallel workers outgrew the CLI default of 128M (also on b80beef0, 2026-10-09). -->
        <ini name="memory_limit" value="2G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="TV_VOICESTUDIO_KEEP_LOCAL_DIR" value="" force="true"/>
        <!-- The tests pin the voice model: a prod-like .env with ESPORTS_VOICE_MODEL=claude-sonnet-5-5 turned LeagueVoiceTest red (P21, 2026-10-13). -->
        <env name="ESPORTS_VOICE_MODEL" value="claude-haiku-5-5" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="ESPORTS_TMNF" value="false" force="true"/>
        <!-- A prod-like .env with TV_COMMENTARY=true put the radio director into every stream daemon test: a slot with nothing to say holds 15 s (tv.commentary.scenes.silent_min_scene_seconds), so TwentyOneStreamTest went red at any hour (2026-10-16). Tests that need the commentary switch it on with config(). -->
        <env name="TV_COMMENTARY" value="false" force="true"/>
        <!-- The text provider the tests assume (a workstation .env says opencode; 2026-10-18 it turned TalkShowActsTest red). -->
        <env name="ESPORTS_VOICE_PROVIDER" value="anthropic" force="true"/>
        <!-- The radio's other workstation switches at their config defaults (2026-10-18: a local .env with its own quiet hours,
             stock model and judge turned QuietHoursTest, StockCoherenceTest and others red on every machine but prod). -->
        <env name="TV_COMMENTARY_AI" value="true" force="true"/>
        <env name="TV_COMMENTARY_QUIET_FROM" value="01:00" force="true"/>
        <env name="TV_COMMENTARY_QUIET_TO" value="09:00" force="true"/>
        <env name="TV_COMMENTARY_STOCK_FROM" value="01:00" force="true"/>
        <env name="TV_COMMENTARY_STOCK_TO" value="09:00" force="true"/>
        <env name="TV_COMMENTARY_STOCK_MODEL" value="claude-sonnet-5-5" force="true"/>
        <env name="TV_COMMENTARY_STOCK_JUDGE" value="true" force="true"/>
        <env name="TV_COMMENTARY_STOCK_DAILY_CAP" value="220" force="true"/>
        <env name="TV_COMMENTARY_SHOWS_DAILY_CAP" value="120" force="true"/>
        <env name="TV_COMMENTARY_TALKSHOW_DAILY_CAP" value="60" force="true"/>
        <env name="TV_COMMENTARY_SERVER" value="https://esports.einundzwanzig.space" force="true"/>
        <env name="TV_COMMENTARY_TOKEN" value="(null)" force="true"/>
        <!-- The chat reply gate stays on in the suite: its tests check what it drops; prod runs it off (2026-10-18). -->
        <env name="TV_COMMENTARY_CHAT_GATE" value="true" force="true"/>
        <env name="TV_VOICESTUDIO_URL" value="http://127.0.0.1:3900" force="true"/>
        <env name="TV_VOICESTUDIO_PROFILE" value="ee7a2a18" force="true"/>
        <env name="TV_VOICESTUDIO_PROFILE_SIRIUS" value="446d98e1" force="true"/>
        <env name="TV_VOICESTUDIO_SPEED" value="1.0" force="true"/>
        <env name="TV_VOICESTUDIO_SPEED_SIRIUS" value="0.92" force="true"/>
        <env name="ESPORTS_VOICE_OPENCODE_SSH" value="" force="true"/>
        <!-- The night's Wavlake overlay catalog (storage/app/stream/music-sync) stays out of every test: a sync run on a dev machine would otherwise change what the music tests read. Tests that need it set config(). -->
        <env name="TWENTYONE_STREAM_MUSIC_OVERLAY" value="" force="true"/>
        <env name="TV_COMMENTARY_NEWS" value="false" force="true"/>
        <env name="TV_COMMENTARY_HISTORY" value="false" force="true"/>
        <!-- The radio programme's rubrics, teasers and news talk (plan "TWENTY ONE Radio", P5) depend on the clock: their own tests switch them on. -->
        <env name="TV_COMMENTARY_RUBRICS" value="false" force="true"/>
        <env name="TV_COMMENTARY_TEASERS" value="false" force="true"/>
        <env name="TV_COMMENTARY_NEWS_TALK" value="false" force="true"/>
        <!-- The pattern fallback is off in production (AI only); the suite keeps it on, tests of the AI-only default switch it off. -->
        <env name="TV_COMMENTARY_PATTERNS" value="true" force="true"/>
        <!-- Programme blocks, the day stock and replays are switched on in production .env files; their own tests switch them on. -->
        <env name="TV_COMMENTARY_BLOCKS" value="false" force="true"/>
        <env name="TV_COMMENTARY_BUDGET" value="false" force="true"/>
        <env name="TV_COMMENTARY_STOCK" value="false" force="true"/>
        <env name="TV_COMMENTARY_REPLAY" value="false" force="true"/>
        <env name="TV_COMMENTARY_DUET_SHARE" value="0" force="true"/>
        <env name="TV_COMMENTARY_CHAT_DUET_SHARE" value="0" force="true"/>
        <env name="TWENTYONE_STREAM_ROTATE_MINUTES" value="0" force="true"/>
        <!-- The suite pins the old draw rules (first block after the close, six confirmations); TournamentDrawOnTipTest covers the default. -->
        <env name="ESPORTS_BITCOIN_DRAW_BLOCK" value="next" force="true"/>
        <env name="ESPORTS_BITCOIN_CONFIRMATIONS" value="6" force="true"/>
        <env name="ESPORTS_RELAYS" value="" force="true"/>
        <env name="ESPORTS_CHAT_RELAYS" value="" force="true"/>
        <env name="ESPORTS_PROFILE_RELAYS" value="" force="true"/>
        <env name="IMG_PROXY_URL" value="" force="true"/>
        <env name="ESPORTS_NOTIFICATION_NSEC" value="" force="true"/>
        <env name="ESPORTS_LEAGUE_NSEC" value="" force="true"/>
        <env name="ESPORTS_TRUST_NSEC" value="" force="true"/>
        <env name="ESPORTS_BADGE_NSEC" value="" force="true"/>
        <env name="ESPORTS_NWC_URI" value="" force="true"/>
        <env name="ESPORTS_NWC_RECEIVE_URI" value="" force="true"/>
        <env name="ESPORTS_LNURL_NSEC" value="" force="true"/>
        <env name="ESPORTS_STREAM_BOT_ENABLED" value="false" force="true"/>
        <env name="ESPORTS_STREAM_BOT_NSEC" value="" force="true"/>
        <env name="ESPORTS_STREAM_BOT_CHAT_RELAYS" value="" force="true"/>
        <env name="ESPORTS_STREAM_BOT_QUIET_HOURS" value="" force="true"/>
        <env name="ESPORTS_NIGHT_PAUSE" value="false" force="true"/>
        <env name="ESPORTS_CASUAL_CUP_GAMES" value="" force="true"/>
        <env name="ESPORTS_STREAM_CHAT_RELAYS" value="" force="true"/>
        <env name="ESPORTS_POOL_NPUB" value="" force="true"/>
        <env name="ESPORTS_INVOICE_NETWORKS" value="bcrt" force="true"/>
        <env name="WEBPUSH_VAPID_PUBLIC_KEY" value="" force="true"/>
        <env name="WEBPUSH_VAPID_PRIVATE_KEY" value="" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
